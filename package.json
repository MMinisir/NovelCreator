{
  "name": "novel-creator",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "小说创作辅助工具：本地优先、方法论驱动、面向中文小说创作者的设定管理与写作工作台",
  "author": "MMinisir",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:electron": "tsc -b && vite build --mode electron",
    "electron:dev": "npm run build:electron && electron .",
    "dist:exe": "node scripts/build-desktop.mjs",
    "dist:exe:minor": "node scripts/build-desktop.mjs --minor",
    "dist:exe:major": "node scripts/build-desktop.mjs --major"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "cytoscape": "^3.34.2",
    "dexie": "^4.0.8",
    "docx": "^9.7.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0",
    "react-window": "^2.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.7.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.novelcreator.desktop",
    "productName": "NovelCreator",
    "directories": {
      "output": "release-desktop"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "NovelCreator-v${version}.${ext}"
    }
  }
}
